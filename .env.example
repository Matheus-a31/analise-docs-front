# ===========================================
# JUS DIGITAL - FRONTEND ENVIRONMENT TEMPLATE
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER put private keys or OpenAI tokens in the frontend!

# Back-end REST API URL
VITE_API_URL="http://localhost:3000/api"

# Google OAuth 2.0 Public Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
